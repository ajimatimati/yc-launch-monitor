# ==============================================================================
# YC & Speedrun Launch Monitor - Environment Configuration
# ==============================================================================

# --- Slack Integration ---
# Bot User OAuth Token starting with xoxb- (Found in Slack App > OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Target Slack Channel ID (e.g. C0123456789) or User ID for Direct Messages (e.g. U0123456789)
SLACK_CHANNEL_ID=C0123456789

# Optional: Incoming Webhook URL (alternative fallback if not using Bot User OAuth)
SLACK_WEBHOOK_URL=

# --- Monitoring & Cadence ---
# Cadence in hours between automated incremental monitoring runs (Default: 8)
POLL_INTERVAL_HOURS=8

# Batches to focus on (Comma-separated, e.g. S26,W26,F25,S25,SR006,SR007)
TARGET_BATCHES=S26,W26,F26,S25,SR006,SR007

# Enable/Disable specific monitors (true/false)
ENABLE_YC_DIRECTORY=true
ENABLE_SPEEDRUN_DIRECTORY=true
ENABLE_X_TWITTER=true
ENABLE_LINKEDIN=true

# --- Social Media Crawler Credentials (Optional / Zero-Cost Fallbacks included) ---
# Twitter/X API v2 Bearer Token (Optional: bot includes zero-cost public syndication fallback)
TWITTER_BEARER_TOKEN=

# LinkedIn API / Cookie / RapidAPI Key (Optional: bot includes zero-cost public query fallback)
LINKEDIN_API_KEY=

# --- Storage & Database ---
# Local SQLite database file path
DATABASE_PATH=yc_launches.db

# --- Pond Agent Protocol & Server ---
# Port for the Pond Agent FastAPI server
PORT=8000
HOST=0.0.0.0

# Secret Access Key configured on Pond (https://joinpond.ai/agent/create) and verified on POST /runs
POND_ACCESS_KEY=pond_sk_yc_launch_monitor_2026

# GTM Pipeline / Rho User Info
GTM_CONTACT_NAME="Jayson Fung"
GTM_CONTACT_EMAIL="jayson@rho.co"
