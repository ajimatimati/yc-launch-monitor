{
  "display_information": {
    "name": "YC Launch Monitor",
    "description": "Real-time GTM alert bot for YC & Speedrun launches and early founder social signals.",
    "background_color": "#FF6600"
  },
  "features": {
    "bot_user": {
      "display_name": "YC Launch Radar",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "chat:write.public",
        "channels:read",
        "groups:read",
        "im:write",
        "incoming-webhook"
      ]
    }
  },
  "settings": {
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
